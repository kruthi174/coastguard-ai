# Environment variables and secrets
.env
.env.local
.env.*.local
*.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
# Build artifacts
dist/
build/
!frontend/dist/
!frontend/dist/**


# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Databases (prevent committing local state)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Uploads directory contents (preserve directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo
