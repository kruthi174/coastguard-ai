# ==============================================================================
# COASTGUARD AI — ENVIRONMENT VARIABLES SPECIFICATION
# Production & Local Deployment Template
# ==============================================================================

# Server Network Configuration (Render dynamically supplies PORT)
PORT=8000
HOST=0.0.0.0

# Database Configuration:
# - Leave empty to use default local SQLite: database/coastguard.db
# - For Render Managed PostgreSQL: postgresql://user:password@host:5432/coastguard_db
DATABASE_URL=

# SQLite custom database file path (optional, used if DATABASE_URL is not set)
# For Render Persistent Disk: COASTGUARD_DB_PATH=/var/data/coastguard.db
COASTGUARD_DB_PATH=

# Storage Directory for Submitted Photo Evidence
# For Render Persistent Disk: COASTGUARD_UPLOAD_DIR=/var/data/uploads
COASTGUARD_UPLOAD_DIR=backend/uploads

# Security & CORS
ADMIN_SECRET_KEY=coastguard-production-secret-key-change-me
CORS_ORIGINS=*

# Machine Learning Engine Hyperparameters
DBSCAN_DEFAULT_EPS_KM=35.0
DBSCAN_DEFAULT_MIN_SAMPLES=2
NLP_DUPLICATE_THRESHOLD=0.55
